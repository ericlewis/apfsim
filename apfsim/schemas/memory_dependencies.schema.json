{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/memory_dependencies.schema.json",
  "title": "apfsim memory dependency report",
  "type": "object",
  "required": ["schema", "required", "classes", "external_classes", "models", "risks"],
  "properties": {
    "schema": {"const": "apfsim.memory_dependencies.v1"},
    "required": {"type": "boolean"},
    "classes": {"type": "array", "items": {"type": "string"}},
    "external_classes": {"type": "array", "items": {"type": "string"}},
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "selected": {"type": "string"},
          "confidence": {"type": "string"},
          "source": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"type": "string"},
          "message": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {"type": "string"},
          "pattern": {"type": "string"},
          "source": {"type": "string"},
          "match": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
