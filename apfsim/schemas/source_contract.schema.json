{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/source_contract.schema.json",
  "title": "apfsim source intake contract",
  "type": "object",
  "required": ["schema", "profile", "root", "classification", "top", "ports", "sources", "metadata", "memory", "blockers", "recommendations"],
  "properties": {
    "schema": { "const": "apfsim.source_contract.v1" },
    "profile": { "type": "string" },
    "root": { "type": "string" },
    "classification": {
      "type": "object",
      "required": ["mode", "confidence", "status", "reasons"],
      "properties": {
        "mode": { "enum": ["direct-mode", "shell-mode", "family-specific", "architecture-block"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["ready", "blocked"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "top": {
      "type": "object",
      "required": ["selected", "module_count", "candidates"],
      "properties": {
        "selected": { "type": "string" },
        "selected_source": { "type": "string" },
        "explicit": { "type": "string" },
        "qsf_top": { "type": "string" },
        "module_count": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "ports": { "type": "object", "additionalProperties": true },
    "sources": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true },
    "memory": { "type": "object", "additionalProperties": true },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "evidence": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "message"],
        "properties": {
          "action": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "qsf": { "type": ["object", "null"], "additionalProperties": true },
    "paths": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
