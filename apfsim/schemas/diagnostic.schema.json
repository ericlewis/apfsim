{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/diagnostic.schema.json",
  "title": "apfsim diagnostic report",
  "type": "object",
  "required": ["schema", "artifact_dir", "source_result", "ok", "status", "summary", "diagnostics"],
  "properties": {
    "schema": { "const": "apfsim.diagnostics.v1" },
    "artifact_dir": { "type": "string" },
    "source_result": { "type": "string" },
    "ok": { "type": "boolean" },
    "status": { "enum": ["pass", "fail"] },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "infos"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "code", "phase", "severity", "summary", "observed", "expected", "evidence", "likely_causes", "repairs"],
        "properties": {
          "schema": { "const": "apfsim.diagnostic.v1" },
          "code": { "type": "string" },
          "phase": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "summary": { "type": "string" },
          "observed": { "type": "object" },
          "expected": { "type": "object" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact", "json_pointer"],
              "properties": {
                "artifact": { "type": "string" },
                "json_pointer": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "likely_causes": { "type": "array", "items": { "type": "string" } },
          "repairs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "confidence", "description"],
              "properties": {
                "kind": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "description": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
