{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/bridge_summary.schema.json",
  "title": "apfsim bridge summary",
  "type": "object",
  "required": ["endian", "read_latency_cycles", "write_idle_cycles", "write_strobe_cycles", "reads", "writes", "host_commands", "target_commands", "slot_table_ok", "commands"],
  "properties": {
    "endian": { "enum": ["little", "big"] },
    "read_latency_cycles": { "type": "integer", "minimum": 0 },
    "write_idle_cycles": { "type": "integer", "minimum": 0 },
    "write_strobe_cycles": { "type": "integer", "minimum": 1 },
    "reads": { "type": "integer", "minimum": 0 },
    "writes": { "type": "integer", "minimum": 0 },
    "host_commands": { "type": "integer", "minimum": 0 },
    "target_commands": { "type": "integer", "minimum": 0 },
    "slot_table_ok": { "type": "boolean" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["direction", "cycle", "command", "result", "word"],
        "properties": {
          "direction": { "type": "string" },
          "cycle": { "type": "integer", "minimum": 0 },
          "command": { "type": "string" },
          "result": { "type": "string" },
          "word": { "type": "string" },
          "p0": { "type": "string" },
          "p1": { "type": "string" },
          "p2": { "type": "string" },
          "p3": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
