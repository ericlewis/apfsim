{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/source_provenance.schema.json",
  "title": "apfsim source provenance",
  "type": "object",
  "required": ["schema", "profile", "top", "filelist", "shimmed_modules", "generated_files"],
  "properties": {
    "schema": { "const": "apfsim.source_provenance.v1" },
    "profile": { "type": "string" },
    "profile_path": { "type": "string" },
    "root": { "type": "string" },
    "top": { "type": "string" },
    "filelist": { "type": "string" },
    "shimmed_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "kind": { "type": "string" },
          "confidence": { "type": "string" },
          "modules": { "type": "array", "items": { "type": "string" } },
          "memory_classes": { "type": "array", "items": { "type": "string" } },
          "diagnostic_codes": { "type": "array", "items": { "type": "string" } },
          "catalog_source": { "type": "string" },
          "generated_files": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "generated_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "source": { "type": "string" },
          "dest": { "type": "string" },
          "catalog_entry": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "memory_dependencies": { "type": "object" },
    "memory_models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": { "type": "string" },
          "model": { "type": "string" },
          "confidence": { "type": "string" },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "wrapper_generation": { "type": "object", "additionalProperties": true },
    "sim_only_paths": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
