{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/generated_profile.schema.json",
  "title": "apfsim generated profile candidate",
  "type": "object",
  "required": ["schema", "profile", "root", "paths", "selected_shims", "warnings"],
  "properties": {
    "schema": { "const": "apfsim.generated_profile.v1" },
    "profile": { "type": "string" },
    "root": { "type": "string" },
    "output_dir": { "type": "string" },
    "status": { "type": "string" },
    "action": { "type": "string" },
    "paths": {
      "type": "object",
      "required": ["profile", "filelist", "scenario"],
      "properties": {
        "profile": { "type": "string" },
        "filelist": { "type": "string" },
        "scenario": { "type": "string" },
        "notes": { "type": "string" },
        "report": { "type": "string" }
      },
      "additionalProperties": true
    },
    "selected_shims": { "type": "array", "items": { "type": "string" } },
    "selected_shim_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "kind": { "type": "string" },
          "confidence": { "type": "string" },
          "modules": { "type": "array", "items": { "type": "string" } },
          "memory_classes": { "type": "array", "items": { "type": "string" } },
          "diagnostic_codes": { "type": "array", "items": { "type": "string" } },
          "filelist_entries": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "inventory": { "type": "object" }
  },
  "additionalProperties": true
}
