{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apfsim/package_check.schema.json",
  "title": "apfsim APF package check",
  "type": "object",
  "required": ["schema", "root", "core_dir", "ok", "metadata", "package_errors", "package_warnings", "sd_paths", "counts"],
  "properties": {
    "schema": { "const": "apfsim.package_check.v1" },
    "root": { "type": "string" },
    "core_dir": { "type": "string" },
    "ok": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "shortname": { "type": "string" },
        "core_folder": { "type": "string" },
        "expected_core_folder": { "type": "string" },
        "platform_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "package_errors": { "$ref": "#/defs/issues" },
    "package_warnings": { "$ref": "#/defs/issues" },
    "sd_paths": {
      "type": "object",
      "required": ["core_dir", "core_files", "bitstreams", "assets", "saves", "platforms"],
      "properties": {
        "core_dir": { "type": "string" },
        "core_files": { "type": "object" },
        "bitstreams": { "type": "array", "items": { "type": "string" } },
        "assets": { "type": "array", "items": { "type": "string" } },
        "saves": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "counts": { "type": "object" }
  },
  "defs": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
