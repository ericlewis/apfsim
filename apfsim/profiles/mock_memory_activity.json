{
  "name": "mock_memory_activity",
  "description": "Built-in APF mock core with standard apfsim SRAM memory activity counter ports enabled",
  "top": "core_top",
  "filelist": "examples/mock/filelist.f",
  "scenario": "scenarios/boot_rom.yml",
  "metadata_jsons": {
    "data": "examples/mock/data.json",
    "video": "examples/mock/video.json",
    "interact": "examples/mock/interact.json"
  },
  "verilator_flags": [
    "-DAPFSIM_MEMORY_COUNTER_TEST"
  ],
  "memory_activity": {
    "top_port_classes": ["sram"]
  },
  "memory": {
    "schema": "apfsim.memory_dependencies.v1",
    "required": true,
    "classes": ["sram"],
    "external_classes": ["sram"],
    "models": {
      "sram": {
        "selected": "standard_top_counter_ports",
        "confidence": "observed",
        "source": "examples/mock/core_top.sv",
        "notes": "Mock profile exposes standard apfsim SRAM counter ports for runtime artifact validation."
      }
    },
    "risks": []
  },
  "wrapper_generation": {
    "memory_models": {
      "generated": false,
      "classes": ["sram"],
      "activity_counters": [
        "sram_read_count",
        "sram_write_count",
        "sram_bus_contention_error",
        "sram_byte_enable_error"
      ],
      "wire_required": false,
      "confidence": "observed"
    }
  },
  "frames": 2,
  "timeout_cycles": 5000000,
  "build_dir": "build/profiles/mock_memory_activity/obj",
  "artifact_root": "build/profiles/mock_memory_activity/run",
  "required_paths": [
    "examples/mock/core_top.sv",
    "examples/assets/mock.rom"
  ],
  "expected_artifacts": [
    "result.json",
    "video_shape.json",
    "lifecycle.json",
    "bridge.log",
    "video/frame_000001.json",
    "video/frame_000001.ppm",
    "audio/out.wav",
    "audio/stats.json"
  ]
}
