{
  "name": "core_template",
  "description": "Official open-fpga/core-template APF smoke test",
  "external": true,
  "root_env": "CORE_TEMPLATE_ROOT",
  "root_env_alternates": ["TEMPLATE_ROOT"],
  "top": "core_top",
  "filelist": "examples/core_template/filelist.f",
  "scenario": "examples/core_template/template_boot.yml",
  "metadata_jsons": {
    "data": "{root}/data.json",
    "video": "{root}/video.json",
    "interact": "{root}/interact.json"
  },
  "frames": 2,
  "timeout_cycles": 10000000,
  "build_dir": "build/profiles/core_template/obj",
  "artifact_root": "build/profiles/core_template/run",
  "required_paths": [
    "{root}/core.json",
    "{root}/data.json",
    "{root}/video.json",
    "{root}/interact.json",
    "{root}/src/fpga/core/core_top.v",
    "{root}/src/fpga/core/core_bridge_cmd.v",
    "{root}/src/fpga/apf/common.v",
    "{root}/src/fpga/apf/mf_datatable.v"
  ],
  "expected_artifacts": [
    "result.json",
    "video_shape.json",
    "lifecycle.json",
    "bridge.log",
    "video/frame_000001.json",
    "video/frame_000001.ppm",
    "audio/out.wav",
    "audio/stats.json"
  ]
}
