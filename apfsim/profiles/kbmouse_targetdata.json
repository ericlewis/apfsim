{
  "name": "kbmouse_targetdata",
  "description": "Official open-fpga/core-example-kbmouse-targetdata APF target data and controller smoke test",
  "external": true,
  "root_env": "CORE_EXAMPLE_KBMOUSE_TARGETDATA_ROOT",
  "top": "core_top",
  "filelist": "examples/kbmouse_targetdata/filelist.f",
  "scenario": "examples/kbmouse_targetdata/kbmouse_targetdata_boot.yml",
  "metadata_jsons": {
    "data": "{root}/data.json",
    "video": "{root}/video.json",
    "interact": "{root}/interact.json"
  },
  "frames": 5,
  "timeout_cycles": 120000000,
  "write_idle_cycles": 64,
  "target_service_interval_cycles": 1024,
  "build_dir": "build/profiles/kbmouse_targetdata/obj",
  "artifact_root": "build/profiles/kbmouse_targetdata/run",
  "required_paths": [
    "{root}/core.json",
    "{root}/data.json",
    "{root}/video.json",
    "{root}/interact.json",
    "{root}/dist/assets/ex_image_all.bin",
    "{root}/src/fpga/core/core_top.v",
    "{root}/src/fpga/core/core_bridge_cmd.v",
    "{root}/src/fpga/core/mf_linebuf.v",
    "{root}/src/fpga/core/mf_cursorfifo.v",
    "{root}/src/fpga/core/mf_cursorimg.v",
    "{root}/src/fpga/core/cursor.mif",
    "{root}/src/fpga/apf/common.v",
    "{root}/src/fpga/apf/mf_datatable.v",
    "rtl_shims/basicassets_io_sdram_sim.v"
  ],
  "expected_artifacts": [
    "result.json",
    "video_shape.json",
    "lifecycle.json",
    "bridge.log",
    "bridge_summary.json",
    "video/frame_000001.json",
    "video/frame_000001.ppm",
    "audio/out.wav",
    "audio/stats.json"
  ]
}
