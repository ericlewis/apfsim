{
  "name": "mrjong",
  "description": "Mr. Jong real Verilog gameplay smoke test with frame capture",
  "external": true,
  "root_env": "MRJONG_ROOT",
  "root_default": "/Users/ericlewis/Developer/openfpga-arcade-cores/our-pocket-cores/openFPGA-MrJong",
  "top": "core_top",
  "filelist": "examples/mrjong/filelist.f",
  "scenario": "examples/mrjong/mrjong_boot.yml",
  "verilator_flags": [
    "-DAPFSIM_MF_PLLBASE_DIVIDE_1=8",
    "-DAPFSIM_MF_PLLBASE_DIVIDE_2=8"
  ],
  "metadata_jsons": {
    "video": "{root}/dist/Cores/ericlewis.MrJong/video.json",
    "interact": "{root}/dist/Cores/ericlewis.MrJong/interact.json"
  },
  "frames": 12,
  "timeout_cycles": 30000000,
  "write_idle_cycles": 64,
  "build_dir": "build/profiles/mrjong/obj",
  "artifact_root": "build/profiles/mrjong/run",
  "required_paths": [
    "{root}/dist/Assets/Mr. Jong.rom",
    "{root}/dist/Cores/ericlewis.MrJong/video.json",
    "{root}/dist/Cores/ericlewis.MrJong/interact.json"
  ],
  "expected_artifacts": [
    "result.json",
    "bridge.log",
    "video/frame_000001.json",
    "video/frame_000001.ppm",
    "audio/out.wav",
    "audio/stats.json"
  ]
}
