{
  "name": "basicassets",
  "description": "Official open-fpga/core-example-basicassets APF asset/audio/video smoke test",
  "external": true,
  "root_env": "CORE_EXAMPLE_BASICASSETS_ROOT",
  "root_env_alternates": ["BASICASSETS_ROOT"],
  "top": "core_top",
  "filelist": "examples/basicassets/filelist.f",
  "scenario": "examples/basicassets/basicassets_boot.yml",
  "metadata_jsons": {
    "data": "{root}/data.json",
    "video": "{root}/video.json",
    "interact": "{root}/interact.json"
  },
  "frames": 3,
  "timeout_cycles": 120000000,
  "write_idle_cycles": 64,
  "build_dir": "build/profiles/basicassets/obj",
  "artifact_root": "build/profiles/basicassets/run",
  "required_paths": [
    "{root}/core.json",
    "{root}/data.json",
    "{root}/video.json",
    "{root}/interact.json",
    "{root}/dist/assets/ex_image_1.bin",
    "{root}/dist/assets/ex_audio_1.wav",
    "{root}/src/fpga/core/core_top.v",
    "{root}/src/fpga/core/core_bridge_cmd.v",
    "{root}/src/fpga/core/mf_linebuf.v",
    "{root}/src/fpga/apf/common.v",
    "{root}/src/fpga/apf/mf_datatable.v",
    "rtl_shims/basicassets_io_sdram_sim.v"
  ],
  "expected_artifacts": [
    "result.json",
    "video_shape.json",
    "lifecycle.json",
    "bridge.log",
    "video/frame_000001.json",
    "video/frame_000001.ppm",
    "audio/out.wav",
    "audio/stats.json"
  ]
}
